<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            style="-fx-background-color: #f5f5f5;"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.empresalogistica.ViewController.LoginViewController">

    <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="600.0" prefWidth="400.0" spacing="0.0">

        <VBox alignment="TOP_CENTER" spacing="25.0"
              style="-fx-background-color: white; -fx-border-radius: 15; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"
              prefHeight="500.0" prefWidth="300.0">
            <padding>
                <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
            </padding>

            <!-- Título -->
            <VBox alignment="CENTER" spacing="10.0">
                <Label text="Logística Express"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" />
                <Label text="Sistema de Envíos Urbanos"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
            </VBox>

            <!-- Tipo de Perfil -->
            <VBox spacing="8.0">
                <Label text="Tipo de Perfil"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <ComboBox fx:id="cmbTipoPerfil" prefWidth="300.0"
                          style="-fx-background-color: #f1f5f9; -fx-border-color: #d1d5db; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" />
            </VBox>

            <!-- Usuario -->
            <VBox spacing="8.0">
                <Label text="Usuario"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <TextField fx:id="txtUsuario" promptText="Ingrese su correo"
                           style="-fx-background-color: #f1f5f9; -fx-border-color: #d1d5db; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;" />
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="8.0">
                <Label text="Contraseña"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña"
                               style="-fx-background-color: #f1f5f9; -fx-border-color: #d1d5db; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 13px;" />
            </VBox>

            <!-- Botones -->
            <HBox alignment="CENTER" spacing="12.0">
                <Button fx:id="btnIniciarSesion"
                        text="Iniciar Sesión"
                        onAction="#handleIniciarSesion"
                        prefWidth="140.0"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 500; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(37, 99, 235, 0.3), 4, 0, 0, 2);" />

                <Button fx:id="btnRegistrarse"
                        text="Registrarse"
                        onAction="#handleRegistrarse"
                        prefWidth="140.0"
                        style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 500; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(100, 116, 139, 0.3), 4, 0, 0, 2);" />
            </HBox>

            <!-- Mensaje -->
            <Label fx:id="lblMensaje" text="Logistica express"
                   style="-fx-text-fill: #dc2626; -fx-font-size: 11px;" />

        </VBox>
    </VBox>

</AnchorPane>